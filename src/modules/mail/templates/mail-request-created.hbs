<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{company.name}} | Confirmación de cotización</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --color-primary: #1E3A8A;
      --color-primary-foreground: #FFFFFF;
      --color-primary-light: #EFF6FF;

      --color-accent: #F3F4F6;
      --color-accent-foreground: #4B5563;
      --color-muted: #4B5563;
      --color-text: #111827;

      --color-success: #10B981;
      --color-success-foreground: #D1FAE5;
      --color-warning: #F59E0B;
      --color-warning-foreground: #FEF3C7;
      --color-danger: #EF4444;
      --color-danger-foreground: #FEE2E2;
      --color-info: #3B82F6;
      --color-info-foreground: #DBEAFE;

      --font-family: 'Inter', Arial, sans-serif;
      --font-size-xs: 12px;
      --font-size-md: 14px;
      --font-size-lg: 15px;
      --font-size-xl: 19px;
      --font-weight-normal: 400;
      --font-weight-medium: 500;
      --font-weight-bold: 600;

      --spacing-xs: 4px;
      --spacing-sm: 8px;
      --spacing-md: 16px;
      --spacing-lg: 24px;

      --shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    body {
      margin: 0;
      padding: 0;
      background-color: #F9FAFB;
      color: var(--color-text);
      font-family: var(--font-family);
      font-size: var(--font-size-md);
      line-height: 1.5;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      box-shadow: var(--shadow);
      border-radius: var(--border-radius);
      overflow: hidden;
			display: flex;
			flex-direction: column;
			min-height: 100vh;
    }

    /* Header */
    .header {
      padding: var(--spacing-xs);
      display: flex;
      flex-direction: column;
      border-bottom: 1px solid var(--color-accent);
    }

    .header .logo {
      display: flex;
      justify-content: center;

      img {
        height: 25px !important;
				width: auto !important;
      }
    }

		.header .logo-text {
			font-size: var(--font-size-xl);
			font-weight: var(--font-weight-bold);
			text-align: center;
			margin-top: var(--spacing-xs);
		}

    .header p {
      font-size: var(--font-size-xs);
      text-align: center;
      color: var(--color-text-muted);
      width: 100%;
    }

    /* Footer */
    .copyright {
      padding: var(--spacing-xs) var(--spacing-md);
      text-align: center;
      background-color: oklch(0.586 0.253 17.585);
      color: var(--color-primary-foreground);
      font-size: var(--font-size-xs);
    }

    /* Content */
    .content {
      padding: var(--spacing-md) var(--spacing-md);
			flex: 1;
    }

    .content > h1 {
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-bold);
      margin-bottom: var(--spacing-xs);
      color: var(--color-primary);
    }

    .content p {
      font-size: var(--font-size-md);
      margin-bottom: var(--spacing-md);
      color: var(--color-muted);
    }

    /* Order Info */
    .section-status {
      background-color: var(--color-primary-light);
      padding: var(--spacing-sm) var(--spacing-md);
      border-left: 4px solid var(--color-primary);
      margin-top: var(--spacing-md);
      border-radius: 8px;
    }

    .section-status h1 {
      font-size: var(--font-size-md);
      font-weight: var(--font-weight-bold);
      color: var(--color-primary);
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }

    .section-status .status-details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-sm);
      margin-top: var(--spacing-sm);
    }

    .section-status .status-details .status-item {
      border-radius: 4px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .section-status .status-item .item-label {
      font-size: var(--font-size-xs);
      color: var(--color-muted);
      margin-bottom: var(--spacing-xs);
    }

    /* Order Summary */
    .section-summary {
      margin-top: var(--spacing-md);
    }

    .section-summary>h1 {
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-bold);
      margin-bottom: var(--spacing-sm);
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-md);
    }

    /* table */
    .table {
      table-layout: fixed;
      width: 100%;
      border-collapse: collapse;
      margin-top: var(--spacing-sm);
    }
    .table th,
    .table td {
      padding: var(--spacing-xs);
      border-bottom: 1px solid var(--color-accent);
    }

    .table th {
      background-color: var(--color-primary-light);
      color: var(--color-primary);
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
      font-size: var(--font-size-xs);
    }

    .table td {
      font-size: var(--font-size-xs);
      color: var(--color-text);
    }

    .table tbody tr:nth-child(even) {
      background-color: var(--color-accent);
    }

    /* .table tbody tr:hover {
      background-color: var(--color-primary-light);
    } */

    /* Price Summary */
    .price-summary-container {
      display: flex;
      justify-content: flex-end;
      margin-top: var(--spacing-md);
    }

    .price-summary {
      background-color: var(--color-primary-light);
      padding: var(--spacing-sm);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      width: 300px;
    }

    .price-summary .price-item {
      display: flex;
      justify-content: space-between;
      font-size: var(--font-size-xs);
    }

    .price-summary .price-item .total {
      font-weight: var(--font-weight-bold);
      font-size: var(--font-size-md);
      color: var(--color-primary);
    }

    .divider {
      border: none;
      border-top: 1px solid var(--color-muted);
      opacity: 0.5;
      margin: var(--spacing-xs) 0;
    }

    /* Additional Info */
    .section-more-info {
      margin-top: var(--spacing-md);
      background-color: var(--color-accent);
      padding: var(--spacing-sm) var(--spacing-md);
      border-radius: var(--border-radius);
    }

    .section-more-info>h1 {
      font-size: var(--font-size-lg);
    }

    .section-more-info .more-info-item {
      display: flex;
      align-items: start;
      gap: var(--spacing-md);
    }

    .section-more-info .more-info-item svg{
      margin-top: 6px;
      stroke: var(--color-primary);
    }

    .section-more-info .more-info-item .info>h3{
      font-size: var(--font-size-sm);
      color: var(--color-muted);
    }

    .section-more-info .more-info-item .info>p{
      font-size: var(--font-size-xs);
      color: var(--color-muted);
    }

  </style>
</head>

<body>
  <main class="container">
    <header class="header">
			{{#if company.logoUrl}}
      <figure class="logo">
        <img src="{{company.logoUrl}}" height="25px" alt="FiestApp Logo">
      </figure>
      {{else}}
			<h2 class="logo-text">
				Fiest<span style="color: oklch(0.586 0.253 17.585);">App</span>
			</h2>
      {{/if}}
      <p>Tu plataforma de eventos de confianza</p>
    </header>
    <div class="content">
      {{#if toName}}
			<h1>Hola, {{toName}}!</h1>
			{{/if}}
      <p>{{{subtitle}}}</p>
      <section class="section-status">
        <h1>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v6l-4 2"/><circle cx="12" cy="12" r="10"/></svg>
          Estado de la cotización
        </h1>
        <div class="status-details">
          <div class="status-item">
            <span class="item-label">Estado:</span>
            <span class="item-value" style="color: {{order.state.color}};">{{order.state.label}}</span>
          </div>
          <div class="status-item">
            <span class="item-label">Fecha de recepción:</span>
            <span class="item-value">{{order.date}}</span>
          </div>
        </div>
      </section>
      <section class="section-summary">
        <h1>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          Resumen de la cotización
        </h1>
        <table class="table">
          <thead>
            <tr>
              <th align="left" width="10%">cant.</th>
              <th align="left" width="50%">Descripción</th>
              <th align="right">P. Unitario</th>
              <th align="right">Subtotal</th>
            </tr>
          </thead>
          <tbody>
            {{#each order.items}}
            <tr>
              <td align="left">{{this.quantity}}</td>
              <td align="left">
								{{this.name}}
								{{#if this.comment}}
								<br>
								<small style="color: var(--color-muted); font-size: var(--font-size-xs);">💬 ({{this.comment}})</small>
								{{/if}}
							</td>
              <td align="right">{{this.price}}</td>
              <td align="right">{{this.subtotal}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>
      <section class="price-summary-container">
        <div class="price-summary">
          <div class="price-item">
            <span>Subtotal:</span>
            <span>{{order.subtotal}}</span>
          </div>
          <hr class="divider">
          <div class="price-item total">
            <span>Total:</span>
            <span class="total">{{order.total}}</span>
          </div>
        </div>
      </section>
      {{#if moreInfo}}
      <section class="section-more-info">
        <h1>Información adicional</h1>
        {{#each moreInfo}}
        <div class="more-info-item">
          {{{this.icon}}}
          <div class="info">
            <h3>{{this.title}}</h3>
            <p>{{this.description}}</p>
          </div>
        </div>
        {{/each}}
      </section>
      {{/if}}
    </div>
    <footer class="copyright">
      <p>Este correo ha sido generado automáticamente, por favor no responder.</p>
      <p>&copy; {{year}} {{company.name}}. Todos los derechos reservados.</p>
    </footer>
  </main>
</body>

</html>
